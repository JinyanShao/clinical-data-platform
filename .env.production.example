# Copy to .env outside version control, set real secrets, then chmod 600 .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://clinical:replace-with-url-encoded-password@postgres:5432/clinical_data_platform
REDIS_URL=redis://redis:6379/0
# OIDC is mandatory outside development. Keycloak realm roles must contain
# exactly one of: admin, researcher, auditor.
AUTH_MODE=oidc
OIDC_ISSUER_URL=https://keycloak.example/realms/clinical
OIDC_AUDIENCE=clinical-data-platform-api
# OIDC_JWKS_URL=https://keycloak.example/realms/clinical/protocol/openid-connect/certs
MAX_UPLOAD_BYTES=10485760
# Mount the matching operator-vetted JAR in API and worker before enabling.
# FHIR_VALIDATOR_JAR=/opt/fhir-validator/validator_cli.jar
